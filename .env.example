# ============================================================================
# LexiVault AI Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================================

# ============================================================================
# Database Configuration (from CASMARTS core)
# ============================================================================
POSTGRES_HOST=casmarts-core-db-primary
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me_secure_password
POSTGRES_DB=lexivault

# ============================================================================
# Celery Configuration (Redis from CASMARTS core)
# ============================================================================
CELERY_BROKER_URL=redis://casmarts-core-cache:6379/4
CELERY_RESULT_BACKEND=redis://casmarts-core-cache:6379/4

# ============================================================================
# Storage Configuration (MinIO/Ceph from CASMARTS core)
# ============================================================================
CEPH_ENDPOINT_URL=http://casmarts-core-storage:8333
CEPH_ACCESS_KEY=change_me_admin
CEPH_SECRET_KEY=change_me_secure_key
CEPH_BUCKET_NAME=lexivault

# ============================================================================
# Kafka Configuration (from CASMARTS core)
# ============================================================================
KAFKA_BOOTSTRAP_SERVERS=casmarts-core-redpanda:29092
ENABLE_KAFKA=false
KAFKA_TOPIC_FILE_UPLOADED=lexivault.documents.uploaded

# ============================================================================
# Vault Configuration (HashiCorp Vault for secrets management)
# ============================================================================
VAULT_ADDR=http://vault:8200
VAULT_DEV_ROOT_TOKEN_ID=change_me_vault_token

# ============================================================================
# LLM & NIM Configuration (NVIDIA NIM for embeddings)
# ============================================================================
NVIDIA_NIM_API_KEY=change_me_nvidia_key
SYSTEM_MASTER_KEY=change_me_fernet_key
DOCUMENT_ENCRYPTION_KEY=change_me_doc_encryption_key

# ============================================================================
# Ollama Configuration (for local LLM operations)
# ============================================================================
OLLAMA_API_BASE_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_GENERATION_MODEL=mistral
OLLAMA_EMBEDDING_TIMEOUT=1200
OLLAMA_GENERATION_TIMEOUT=1200

# ============================================================================
# Vertex AI / Google Cloud Configuration
# ============================================================================
GCP_PROJECT_ID=project-9a4f42ad-5486-49f3-83b
GCP_LOCATION=us-central1
GCP_CREDENTIALS_JSON=/app/google-v-credentials.json
GOOGLE_APPLICATION_CREDENTIALS=/app/google-v-credentials.json
VERTEX_MODEL=gemini-1.5-pro
LLM_PROVIDER=vertex
DOCLING_PROVIDER=vertex
EMBEDDING_PROVIDER=vertex

# ============================================================================
# Application Configuration
# ============================================================================
FLASK_DEBUG=0
LOG_LEVEL=INFO
JWT_SECRET_KEY=change_me_long_secret_jwt_key_for_token_generation

# ============================================================================
# ClamAV Configuration
# ============================================================================
CLAMAV_HOST=lexivault-clamav
CLAMAV_PORT=3310

# ============================================================================
# Timezone
# ============================================================================
TZ=America/Mexico_City
