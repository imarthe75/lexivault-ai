FROM python:3.10-bookworm

WORKDIR /app

ENV PYTHONPATH=/app:$PYTHONPATH

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libjpeg-dev \
    zlib1g-dev \
    libfreetype6-dev \
    liblcms2-dev \
    libopenjp2-7-dev \
    libtiff5-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install Calibre and Tesseract
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    calibre \
    libfontconfig1 \
    libxrender1 \
    xvfb \
    tesseract-ocr \
    tesseract-ocr-spa \
    tesseract-ocr-eng \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copy backend code
COPY backend/ .

# Download spaCy model
RUN pip install https://github.com/explosion/spacy-models/releases/download/es_core_news_lg-3.7.0/es_core_news_lg-3.7.0.tar.gz

# Default command for celery
CMD ["celery", "-A", "tasks.celery_app", "worker", "--loglevel=info"]